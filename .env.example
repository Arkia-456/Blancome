FREE_MOBILE_USER=
FREE_MOBILE_API_KEY=

# Playlists — add one PLAYLIST_<NAME> per playlist (name will be used as the voice trigger keyword)
# Supported extensions: .m3u8, .txt (one track per line)
PLAYLIST_EXAMPLE=/path/to/playlist.m3u8

SHOPPING_LIST_FILE=/path/to/shopping_list.txt

# Google Calendar — OAuth 2.0 Client ID (Desktop app) from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Calendar — App registration from Azure Portal
# (App registrations > New > Public client/native > add Calendars.Read permission)
MICROSOFT_CLIENT_ID=
